# Generate certs: mkcert -install && mkcert localhost 127.0.0.1
{
	auto_https disable_redirects
}

# HTTP (dev) — mol dev server for /* catch-all
http://localhost:9081 {
	handle /api/* {
		reverse_proxy http://localhost:8081
	}

	# Browser-facing codellm GraphQL must match before the generic /_system/*
	# monolith route below. The session cookie is forwarded and codellm performs
	# the delegated-admin check itself.
	handle /_system/codellm/* {
		reverse_proxy http://localhost:8087
	}

	handle /_system/* {
		reverse_proxy http://localhost:8081
	}

	handle /graphql {
		reverse_proxy http://localhost:8081
	}

	# Same-origin, dumb pass-through to the fleet service (own GraphQL: roles +
	# roleGraph). Forwards the session cookie; NO auth here — auth is the
	# delegated viewer{role} middleware (internal/delegatedadmin) inside fleet.
	# Upstream is a placeholder; the real private addr comes from deploy config.
	handle /_fleet/* {
		reverse_proxy http://localhost:8092
	}

	handle /assets/* {
		reverse_proxy http://localhost:8081
	}

	handle /* {
		reverse_proxy http://localhost:9080
	}
}

# HTTPS (dev, for Cloudflare Turnstile etc.)
# Access via https://localhost:7081
# All traffic goes to Go server (no mol dev server)
localhost:7081 {
	tls localhost+1.pem localhost+1-key.pem
	reverse_proxy http://localhost:8081
}
