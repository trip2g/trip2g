# Example .env for a simple self-hosted trip2g deployment.
# Copy this to .env and replace placeholder values before first public launch.

# Server configuration
PUBLIC_URL=https://docs.example.com
LISTEN_ADDR=0.0.0.0:8081
INTERNAL_LISTEN_ADDR=:8082
DB_FILE=/data/data.sqlite3
GIT_API_REPO_PATH=/data/git
LOG_LEVEL=info
DEV=false
ADMIN_JS_URL=/assets/ui/admin/-/web.js

# Required production secrets
JWT_SECRET=replace-with-long-random-secret
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
# For HTTP-only smoke tests without TLS:
# USER_TOKEN_INSECURE=true

# Owner account and email sign-in
OWNER_EMAIL=owner@example.com
MAIL_FROM=no-reply@example.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_STARTTLS=false

# MinIO storage configuration
MINIO_ROOT_USER=trip2g
MINIO_ROOT_PASSWORD=replace-with-long-random-password
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_URL=https://files.example.com
MINIO_ACCESS_KEY_ID=trip2g
MINIO_SECRET_KEY=replace-with-long-random-password
MINIO_BUCKET=trip2g
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
MINIO_INIT_TIMEOUT=30s
MINIO_URL_EXPIRES_IN=10m
# MINIO_PREFIX=prod
SIMPLE_BACKUP=true

# Optional payments
# NOWPAYMENTS_API_KEY=your_nowpayments_api_key_here
# NOWPAYMENTS_IPN_KEY=your_nowpayments_ipn_key_here

# Optional: dbmate / manual migration commands
DATABASE_URL=sqlite:/data/data.sqlite3

# Optional vector search with OpenAI
# OPENAI_API_KEY=sk-...
# FEATURES={"vector_search":{"enabled":true,"model":"text-embedding-3-small"}}

# Optional vector search with an OpenAI-compatible embeddings API
# OPENAI_API_KEY=provider-token-if-needed
# FEATURES={"vector_search":{"enabled":true,"model":"bge-m3","base_url":"https://embeddings.example.com/v1"}}

# Optional CAPTCHA
# TURNSTILE_SITE_KEY=your_turnstile_site_key
# TURNSTILE_SECRET_KEY=your_turnstile_secret_key
