$trip2g_user_space_home $mol_page
	title @ \My account
	body /
		<= Details $mol_view
			style *
				flexDirection \column
			sub /
				<= Email_labeler $mol_labeler
					title @ \Email
					Content <= Email_value $mol_view
						sub / <= user_email \
				<= Favorites_labeler $mol_labeler
					title @ \Favorite notes
					Content <= Favorites $mol_view
						sub <= favorites /
		<= Empty $mol_view
			sub / <= empty_message \
	Favorites_list $mol_list
		rows <= favorite_rows /
			<= Favorite*0 $mol_link
				title <= favorite_title* \
				uri <= favorite_uri* \
