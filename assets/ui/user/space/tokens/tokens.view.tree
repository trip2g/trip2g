$trip2g_user_space_tokens $mol_page
	title @ \Personal tokens
	tools /
		<= AddLink $mol_link
			arg *
				un \token_new
				token_id null
			title @ \+ New token
	body /
		<= List $mol_list
			rows <= token_rows /
				<= Row*0 $mol_link
					arg *
						un \token
						token_id <= row_id* \
					sub /
						<= Row_content* $mol_row
							sub /
								<= Name* $mol_view
									sub / <= row_name* \
								<= Prefix_label* $mol_labeler
									title @ \Prefix
									Content <= Prefix* $mol_view
										sub / <= row_prefix* \
								<= Expires_label* $mol_labeler
									title @ \Expires
									Content <= Expires* $trip2g_table_cell_time
										value <= row_expires_at* null
								<= Revoked_label* $mol_labeler
									title @ \Revoked
									Content <= Revoked* $trip2g_table_cell_time
										value <= row_revoked_at* null
