$trip2g_user_space $mol_view
	user_email \
	minimal_height 0
	minimal_width 0
	plugins /
		<= Theme $mol_theme_auto
		<= SiteTheme $trip2g_theme
		<= SiteLanguage $trip2g_lang
	SignInButton $mol_button_minor
		click <= open null
		sub / <= SignInIcon $mol_icon_login
	OpenButton $mol_button_minor
		click <= open null
		sub / <= OpenDialogIcon $mol_icon_account
	AdminLink $mol_link
		uri \/admin
		target \_blank
		hint @ \Open Admin Panel
		sub / <= AdminIcon $mol_icon_cog
	Editor $trip2g_editor
	sub /
		<= admin_link null $mol_view
		<= open_button null $mol_view
		<= Search $trip2g_user_search_toggle
		<= Live $trip2g_user_live
		<= Options_pop $mol_pop_over
			hint \Click to show options menu
			align \bottom_left
			Anchor <= Options_anchor $mol_button_major sub /
				<= Options_trigger_icon $mol_icon_menu
			bubble_content /
				<= Options_content $mol_list rows /
					<= editor null $mol_view
					<= List_of_languages $mol_locale_select
						Filter null
						dictionary *
							ru \Русский
							en \English
					<= Lighter $mol_lights_toggle
						title @ \Toggle theme
					<= ChangePageWatcher $trip2g_user_live_reload_toggler
					<= FollowPageWatcher $trip2g_user_live_follow_toggler
		<= Dialog $mol_view
			dom_name \dialog
			attr * open <= open_status null null|string
			event *
				click?event <=> close_click?event null
				close?event <=> close_event?event null
			sub /
				<= AuthWrapper $trip2g_auth
					signout => signout
					reload_me <= reload_page null
					AppView <= Content
				<= CloseButton $mol_button_major
					click <= close null
					sub /
						<= CloseIcon $mol_icon_close
	Content $trip2g_user_space_nav
		user_email <= user_email
		signout? <=> signout?

$trip2g_user_space_nav $mol_book2_catalog
	param \un
	Spread_default <= Home
	menu_title @ \My account
	user_email \
	signout? null
	menu_foot /
		<= SignOut $mol_button_major
			title @ \Sign Out
			click? <=> signout?
	spreads *
		home <= Home $trip2g_user_space_home
		subscriptions <= Subscriptions $trip2g_user_space_subscriptions
		tokens <= Tokens $trip2g_user_space_tokens
		token_new <= TokenNew $trip2g_user_space_tokens_create
		token <= TokenShow $trip2g_user_space_tokens_show

$trip2g_user_space_name $mol_view
	value \
	sub / <= value
