$trip2g_user_paywall_conversationprompt_email $mol_view
	SuccessView $mol_view
		sub / <= success_message @ \Thanks, we got your e-mail and will let you know when offers appear.
	sub /
		<= Form $mol_form
			body /
				<= Email_field $mol_form_field
					name @ \Your e-mail
					bid <= email_bid \
					Content <= Email_control $mol_string
						hint \hello@example.com
						value? <=> email? \
			submit? <=> request? null
			submit_allowed => request_allowed
			buttons /
				<= Signup $mol_button_major
					title @ \Subscribe
					click? <=> request? null
					enabled <= request_allowed
				<= Result $mol_status
					message <= result? \
