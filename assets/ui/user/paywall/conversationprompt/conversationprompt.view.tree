$trip2g_user_paywall_conversationprompt $mol_view
	waitlist null any
	TelegramButton $mol_link
		title @ \Telegram bot
		uri <= tg_bot_url \
	EmailForm $trip2g_user_paywall_conversationprompt_email
	sub /
		<= Title $mol_view
			sub / <= title @ \There are no offers right now, so access cannot be bought.
		<= Message $mol_view
			sub / <= message @ \Want to know when it opens? Join the wait list in the Telegram bot or leave your e-mail.
