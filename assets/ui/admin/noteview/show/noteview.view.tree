$trip2g_admin_noteview_show $mol_page
	noteview_id \
	note_path_id 0
	body /
		<= Path_labeler $mol_labeler
			title \Path
			Content <= Path $trip2g_admin_cell
				content <= path \
		<= Title_labeler $mol_labeler
			title \Title
			Content <= Title $trip2g_admin_cell
				content <= title \
		<= Permalink_labeler $mol_labeler
			title \Permalink
			Content <= Permalink $trip2g_admin_cell
				content <= permalink \
		<= Text $mol_text
			text <= content \
		<= FormSubmits $trip2g_admin_form_submits
			note_path_id <= note_path_id

