$trip2g_admin_noteview_graph $mol_page
	title \Note Graph
	close_icon null $mol_view
	menu_tools / <= close_icon
	body /
		<= Header $mol_row
			sub /
				<= AutoLayoutButton $mol_button_minor
					title \Auto layout
					click? <=> auto_layout? null
				<= SavePositionsButton $mol_button_minor
					title \Save positions
					click? <=> save_positions? null
				<= PublicOutsideCheck $mol_check_box
					title \Public outside
					checked? <=> public_outside? false
				<= GroupByLabel $mol_view
					sub / \Group by:
				<= GroupByString $mol_string
					hint \subgraph
					value? <=> group_by? \subgraph
				<= save_message? \
		<= Graph $trip2g_admin_noteview_graph_cytoscape
			public_outside <= public_outside
			group_by <= group_by
			save_message? <=> save_message?
		<= moves_watcher null

$trip2g_admin_noteview_graph_cytoscape $mol_view
	relayout? null
	save_all? null
	public_outside false
	group_by \subgraph
	save_message? \
