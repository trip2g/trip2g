$trip2g_admin_subgraph_show $mol_page
	subgraph_id 0
	title <= subgraph_name \
	body /
		<= Form $mol_form
			body /
				<= Name_labeler $mol_labeler
					title \Name
					Content <= Name $trip2g_admin_cell
						content <= subgraph_name
				<= Human_description_field $mol_form_field
					name @ \What this subgraph is
					hint @ \One sentence. A peer granted access to it is shown this, and a slug on its own tells them nothing.
					bid <= human_description_bid \
					Content <= human_description_control $mol_string
						value? <=> subgraph_human_description? \
				<= Color_field $mol_form_field
					name \Color
					bid <= color_bid \
					Content <= color_control $mol_string
						value? <=> subgraph_color? \
				<= Hidden_field $mol_form_field
					name \Hidden
					bid <= hidden_bid \
					Content <= hidden_control $mol_check_box
						checked? <=> subgraph_hidden? false
				<= Require_signin_field $mol_form_field
					name @ \Require sign-in
					bid <= require_signin_bid \
					Content <= require_signin_control $mol_check_box
						checked? <=> subgraph_require_signin? false
			buttons /
				<= Submit $mol_button_major
					title \Submit
					click? <=> submit? null
				<= Result $mol_status
					message <= result? \
