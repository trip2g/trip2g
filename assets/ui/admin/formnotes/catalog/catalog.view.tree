$trip2g_admin_formnotes_catalog $trip2g_admin_catalog
	menu_title @ \Form Notes
	param \path
	Content* $trip2g_admin_formnotes_show
		note_path_id <= row_path_id* 0
	menu_link_content* / <= Item* $mol_view
		sub /
			<= Rows* $mol_row
				minimal_height 24
				minimal_width 500
				sub <= row_content* /
					<= Row_path_labeler* $mol_labeler
						title @ \Note
						Content <= Row_path* $trip2g_admin_cell
							content <= row_path* \
					<= Row_count_labeler* $mol_labeler
						title @ \Submits
						Content <= Row_count* $trip2g_admin_cell
							content <= row_count* \
					<= Row_last_labeler* $mol_labeler
						title @ \Last Submit
						Content <= Row_last* $trip2g_admin_cell
							content <= row_last* \
