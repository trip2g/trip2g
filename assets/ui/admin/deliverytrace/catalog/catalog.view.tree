$trip2g_admin_deliverytrace_catalog $trip2g_admin_catalog
	menu_title @ \Delivery Chains
	param \id
	Empty $mol_status
	ShowPage* $trip2g_admin_deliverytrace_show
		trace <= row_id* \
	menu_link_content* / <= TraceItem* $mol_view
		sub /
			<= Rows* $mol_row
				minimal_height 24
				minimal_width 800
				sub <= row_content* /
					<= Id* $trip2g_admin_labeler_id
						value <= row_id_string* \id
					<= Row_started_labeler* $mol_labeler
						title @ \Started
						Content <= Row_started* $trip2g_admin_cell
							content <= row_started* \-
					<= Row_deliveries_labeler* $mol_labeler
						title @ \Deliveries
						Content <= Row_deliveries* $trip2g_admin_cell
							content <= row_deliveries* \-
					<= Row_tokens_labeler* $mol_labeler
						title @ \Tokens
						Content <= Row_tokens* $trip2g_admin_cell
							content <= row_tokens* \-
					<= Row_depth_labeler* $mol_labeler
						title @ \Depth
						Content <= Row_depth* $trip2g_admin_cell
							content <= row_depth* \-
