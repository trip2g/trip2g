$trip2g_admin_secrets $mol_section
	key_prefix \
	title @ \Secrets
	KeyRow* $mol_row
		sub <= key_row_sub* /
	KeyName* $mol_string
		value <= key_name* \
	KeyValueInput* $mol_string
		hint \***
		value? <=> key_new_value*? \
	KeySave* $mol_button_major
		sub /
			<= KeySaveIcon* $mol_icon_content_save
			<= key_save_label @ \Save
		click? <=> key_save*? null
	KeyDelete* $trip2g_button_confirm
		ActionIcon $mol_icon_trash_can_outline
		click? <=> key_delete*? null
	content /
		<= KeysList $mol_list
			rows <= key_rows /
		<= AddRow $mol_row
			sub /
				<= NameControl $mol_string
					hint \Secret Name
					value? <=> new_name? \
				<= ValueControl $mol_string
					hint \Value
					value? <=> new_value? \
				<= AddButton $mol_button_major
					sub /
						<= AddIcon $mol_icon_plus
						<= add_label @ \Add Secret
					click? <=> add_secret? null
		<= AddResult $mol_status
			message <= add_result? \
