$trip2g_admin_federation_catalog $trip2g_admin_catalog
	menu_title @ \Federation Secrets
	param \id
	Empty $mol_status
	actions /
		<= AddInboundLink $mol_link
			arg * id \add_inbound
			title \+ Add Inbound
		<= AddOutboundLink $mol_link
			arg * id \add_outbound
			title \+ Add Outbound
	Content* $trip2g_admin_federation_show
		secret_id <= row_id* 0
		revoked <= row_revoked* false
	AddInboundForm $trip2g_admin_federation_create_inbound
	AddOutboundForm $trip2g_admin_federation_create_outbound
	menu_link_content* / <= SecretItem* $mol_view
		sub /
			<= Rows* $mol_row
				minimal_height 24
				minimal_width 700
				sub <= row_content* /
					<= Id* $trip2g_admin_labeler_id
						value <= row_id_string* \id
					<= Kid* $mol_labeler
						title @ \Key ID
						Content <= KidCell* $trip2g_admin_cell
							content <= row_kid* \kid
					<= KbUrl* $mol_labeler
						title @ \KB URL
						Content <= KbUrlCell* $trip2g_admin_cell
							content <= row_kb_url* \
					<= SubgraphCount* $mol_labeler
						title @ \Subgraphs
						Content <= SubgraphCountCell* $trip2g_admin_cell
							content <= row_subgraph_count* \0
					<= CreatedAt* $trip2g_admin_labeler_moment
						title @ \Created At
						value <= row_created_at* \
					<= RevokedAt* $trip2g_admin_labeler_moment
						title @ \Revoked At
						value <= row_revoked_at* \
