$trip2g_admin_federation_inbound $mol_page
	title @ \Add Inbound Secret
	SecretHexView $mol_view
		style *
			flexDirection \column
		sub /
			<= Key_labeler $mol_labeler
				title @ \Handover key — send this one value (shown once)
				Content <= KeyCell $trip2g_admin_cell
					content <= handover_key? \
			<= Key_hint $mol_view
				sub / <= key_hint @ \Packs the key id, the address of this instance and the secret. The other operator pastes it into Add Outbound. Send it over a channel you would trust with a password.
			<= Buttons $mol_row
				sub /
					<= Copy_key $mol_button_copy
						title @ \Copy handover key
						text <= handover_key
					<= Copy_secret $mol_button_copy
						title @ \Copy secret only
						text <= secret_hex
			<= SecretHex_labeler $mol_labeler
				title @ \Secret, on its own
				Content <= SecretHexCell $trip2g_admin_cell
					content <= secret_hex? \
			<= Kid_out_labeler $mol_labeler
				title @ \Key ID
				Content <= KidOutCell $trip2g_admin_cell
					content <= kid
	body /
		<= Form $mol_form
			body /
				<= Kid_field $mol_form_field
					name @ \Key ID (kid)
					bid <= kid_bid \
					Content <= kid_control $mol_string
						value? <=> kid? \
				<= Description_field $mol_form_field
					name @ \Description
					hint @ \Why this key exists. Read here, on this page, and nowhere else.
					bid <= description_bid \
					Content <= description_control $mol_string
						value? <=> description? \
				<= KbId_field $mol_form_field
					name @ \Base id for the other side
					hint @ \The slug they will address this base by. Defaults to this instance's hostname.
					bid <= kb_id_bid \
					Content <= kb_id_control $mol_string
						value? <=> kb_id? \
				<= About_field $mol_form_field
					name @ \When to ask this base
					hint @ \One line, packed into the key. It becomes the "use when" of their KB-note, which is what tells them later whether to search here.
					bid <= about_bid \
					Content <= about_control $mol_string
						value? <=> about? \
			buttons /
				<= Submit $mol_button_major
					title @ \Generate Secret
					click? <=> submit? null
				<= Result $mol_status
					message <= result? \
