$trip2g_admin_federation_inbound $mol_page
	title @ \Add Inbound Secret
	SecretHexView $mol_view
		style *
			flexDirection \column
		sub /
			<= Key_labeler $mol_labeler
				title @ \Handover key — send this one value (shown once)
				Content <= KeyCell $trip2g_admin_cell
					content <= handover_key? \
			<= Key_hint $mol_view
				sub / @ \It packs the key id, this instance's address and the secret. The other operator pastes it into Add Outbound. Send it over a channel you would trust with a password.
			<= SecretHex_labeler $mol_labeler
				title @ \Secret, on its own
				Content <= SecretHexCell $trip2g_admin_cell
					content <= secret_hex? \
			<= Kid_out_labeler $mol_labeler
				title @ \Key ID
				Content <= KidOutCell $trip2g_admin_cell
					content <= kid
	body /
		<= Form $mol_form
			body /
				<= Kid_field $mol_form_field
					name @ \Key ID (kid)
					bid <= kid_bid \
					Content <= kid_control $mol_string
						value? <=> kid? \
				<= Description_field $mol_form_field
					name @ \Description
					bid <= description_bid \
					Content <= description_control $mol_string
						value? <=> description? \
			buttons /
				<= Submit $mol_button_major
					title @ \Generate Secret
					click? <=> submit? null
				<= Result $mol_status
					message <= result? \
