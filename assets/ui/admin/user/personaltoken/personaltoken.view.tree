$trip2g_admin_user_personaltoken $mol_view
	user_id 0
	token? \
	instructions? \
	expires_at? \
	generate_allowed true
	generate? null
	style *
		flexDirection \column
	sub /
		<= Token $mol_view
			style *
				flexDirection \column
			sub /
				<= Token_labeler $mol_labeler
					title \Personal token
					Content <= Token_value $trip2g_admin_cell
						content <= token \
				<= ExpiresAt_labeler $mol_labeler
					title \Expires At
					Content <= ExpiresAt $trip2g_admin_cell
						content <= expires_at \
				<= Instructions_labeler $mol_labeler
					title \Instructions for the holder (contain the token)
					Content <= Instructions_value $mol_text
						text <= instructions \
				<= Buttons $mol_row
					sub /
						<= Copy_token $mol_button_copy
							title \Copy token
							text <= token \
						<= Copy_instructions $mol_button_copy
							title \Copy instructions
							text <= instructions \
						<= Hide $mol_button_minor
							title \Hide
							click? <=> hide? null
		<= Result $mol_status
			message <= result? \
