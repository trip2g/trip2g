$trip2g_admin_formsubmits_catalog $mol_view
	note_path_id 0
	CustomColumn* $mol_labeler
		title <= row_fields_key* \
		Content <= Row_field_value* $trip2g_admin_cell
			content <= row_fields_value* \
	sub /
		<= Submits $mol_list
			rows <= rows /$mol_view
				<= Row*0 $mol_view
					style *
						flexDirection \column
					sub /
						<= Row_meta* $mol_row
							minimal_height 24
							sub <= columns* /$mol_labeler
								<= Row_created_at_labeler* $trip2g_admin_labeler_moment
									format \YYYY-MM-DD hh:mm
									value <= row_created_at* \
								<= Row_ip_labeler* $mol_labeler
									title \IP
									Content <= Row_ip* $trip2g_admin_cell
										content <= row_ip* \
								<= Row_form_id_labeler* $mol_labeler
									title \Form
									Content <= Row_form_id* $trip2g_admin_cell
										content <= row_form_id* \
								<= Row_status_labeler* $mol_labeler
									title @ \Status
									Content <= Row_status* $trip2g_admin_cell
										content <= row_status* \
