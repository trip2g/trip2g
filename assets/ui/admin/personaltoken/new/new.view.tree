$trip2g_admin_personaltoken_new $mol_page
	title \New Personal Token
	user_id 0
	created? \
	instructions? \
	Result_view $mol_view
		style *
			flexDirection \column
		sub /
			<= Note $mol_view
				sub / \The token is hashed, so it is shown once and never again.
			<= Instructions_labeler $mol_labeler
				title \Ready to hand over
				Content <= Instructions_value $mol_text
					text <= instructions \
			<= Buttons $mol_row
				sub /
					<= Copy_instructions $mol_button_copy
						title \Copy instructions
						text <= instructions \
					<= Copy_token $mol_button_copy
						title \Copy token only
						text <= created \
	body /
		<= Form $mol_form
			body /
				<= UserId_field $mol_form_field
					name \User ID
					Content <= UserId_control $mol_number
						value? <=> user_id_field? 0
				<= Name_field $mol_form_field
					name \Name
					Content <= Name_control $mol_string
						value? <=> name? \
				<= Expiry_field $mol_form_field
					name \Expires in
					Content <= Expiry_control $mol_switch
						value? <=> expiry? \90d
						options *
							30d \30 days
							90d \90 days
							1y \1 year
							never \Never
			buttons /
				<= Submit $mol_button_major
					title \Submit
					click? <=> submit? null
				<= Result $mol_status
					message <= result? \
