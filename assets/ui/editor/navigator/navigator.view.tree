$trip2g_editor_navigator $mol_list
	path? \
	query? \
	paths /string
	ids_tags *
	rows /
		<= Search $mol_string
			hint @ \Search files...
			value? <=> query?
		<= Tree $trip2g_editor_navigator_tree
			ids_tags <= ids_tags
			levels_expanded 0
			force_expanded <= searching false
			Item* <= Item* $mol_button_minor
				title <= item_title* \
				click? <=> item_click*? null

$trip2g_editor_navigator_tree $mol_tag_tree
	force_expanded false
