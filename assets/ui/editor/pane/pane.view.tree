$trip2g_editor_pane $mol_view
	path? \
	content? \
	right_sidebar? \
	newfile_value? \
	newfile_error? \
	diff_from_version_id? 0
	diff_to_version_id? 0
	close null
	sub /
		<= watcher_result null
		<= Navigation $mol_page
			title @ \Files
			tools /
				<= NewFileButton $mol_button_minor
					hint @ \New file
					click? <=> handle_newfile_click? null
					sub /
						<= NewFileIcon $mol_icon_plus
				<= CloseButton $mol_button_minor
					click <= close null
					sub /
						<= CloseIcon $mol_icon_close
			body /
				<= Navigator $trip2g_editor_navigator
					style *
						flex \1
					path? <=> path?
		<= Editor $mol_page
			title <= file_title \
			tools /
				<= VersionsButton $mol_button_minor
					click? <=> handle_versions_click? null
					sub /
						<= VersionsIcon $mol_icon_history
				<= DownloadButton $mol_button_minor
					enabled <= has_content false
					click? <=> download? null
					sub /
						<= DownloadIcon $mol_icon_download
				<= SaveButton $mol_button_minor
					enabled <= dirty false
					click? <=> handle_save_click? null
					sub /
						<= SaveIcon $mol_icon_content_save
						<= save_text @ \Save {0} files
			body <= editor_body /
		<= right_sidebar_widget null $mol_view
	ContentTextarea $mol_textarea
		value? <=> content?
		hover? <=> handle_content_hover? null
		event *
			^
			click? <=> handle_content_click? null
	Placeholder $mol_view
		sub /
			<= placeholder_text @ \Choose file in the left panel
	UpdateBanner $mol_bar
		sub /
			<= BannerIcon $mol_icon_update
			<= BannerText $mol_view
				style *
					flex \1
				sub /
					<= banner_text @ \This file was updated elsewhere
			<= ShowDiffButton $mol_button_minor
				hint @ \Show what changed
				click? <=> handle_show_diff? null
				sub /
					<= show_diff_text @ \Show diff
			<= KeepBothButton $mol_button_minor
				hint @ \Merge both versions with conflict markers
				click? <=> handle_keep_both? null
				sub /
					<= keep_both_text @ \Keep both
			<= KeepMineButton $mol_button_minor
				hint @ \Discard the external change, keep your edits
				click? <=> handle_keep_mine? null
				sub /
					<= keep_mine_text @ \Keep mine
			<= LoadLatestButton $mol_button_major
				click? <=> handle_load_latest? null
				sub /
					<= load_latest_text @ \Load latest
	Versions $trip2g_editor_versions
		path <= path
		content? <=> content?
		diff_from_version_id? <=> diff_from_version_id?
		diff_to_version_id? <=> diff_to_version_id?
		show_diff? <=> handle_versions_show_diff? null
	Diff $trip2g_editor_diff
		from_version_id <= diff_from_version_id 0
		to_version_id <= diff_to_version_id 0
	SaveList $trip2g_editor_savelist
		files <= changed_paths /string
		submit? <=> save_confirm? null
	NewFile $trip2g_editor_newfile
		value? <=> newfile_value?
		error <= newfile_error
		create? <=> handle_create_file? null
	newfile_msg_empty @ \Enter a file name
	newfile_msg_exists @ \A file with this name already exists
	newfile_msg_exists_remote @ \This file was just created elsewhere
