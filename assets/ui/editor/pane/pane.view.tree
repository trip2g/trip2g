$trip2g_editor_pane $mol_view
	content? \
	preview_html \
	path? \
	navigator_visible? true
	preview_visible? false
	close null
	sub <= columns /$mol_view
	Navigator $trip2g_editor_navigator
		path? <=> path?
	Content $trip2g_editor_content
		content? <=> content?
		path <= path
		navigator_visible? <=> navigator_visible?
		preview_visible? <=> preview_visible?
		close <= close
	Preview $trip2g_editor_preview
		preview_html <= preview_html
