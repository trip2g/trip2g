$trip2g_editor_content $mol_page
	content? \
	path \
	navigator_visible? true
	preview_visible? false
	close null
	title <= file_title \
	tools /
		<= Navigator_toggle $mol_check
			title @ \Files
			checked? <=> navigator_visible?
		<= Preview_toggle $mol_check
			title @ \Preview
			checked? <=> preview_visible?
		<= Download $mol_button_download
			enabled <= has_content
			blob <= content_blob null
			file_name <= download_name \note.md
			title @ \Download
		<= CloseButton $mol_button_minor
			click <= close null
			sub / <= CloseIcon $mol_icon_close
	body /
		<= Area $mol_textarea
			value? <=> content?
