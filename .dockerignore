# Infrastructure and deployment
infra/
scripts/

# Docker files
Dockerfile
docker-compose*.yml
.dockerignore

# Version control
.git/
.gitignore
.gitattributes

# Dependencies (glob form so BuildKit matches too — trailing-slash form was skipped by BuildKit)
**/node_modules

# Build artifacts
tmp/
server
*.fasthttp.gz
*easyjson-bootstrap*
# generated at build by `go generate ./onboarding-vault`; a stale/empty local
# placeholder breaks the in-build `zip -r` (it tries to append to a non-zip).
onboarding-vault/vault.zip

# Database files
*.sqlite*

# IDE and editor
.vscode/
.idea/
*.swp
*.swo
*~

# Environment and config
.env
.env.*
run.sh

# Development files
.aider*
examples.json
.air.toml

# Test files
e2e/
playwright-report/
test-results/
.test-api-key

# Documentation
docs/
README.md
CLAUDE.md
# Dockerfile.docs bakes the user docs into an image
!docs/en/user
!docs/ru/user
!docs/patches
!scripts/docs-image-entrypoint.sh

# Demo video assets (mp4/gif/mkv — not needed in build)
docs/demo-video/
**/*.mp4
**/*.mkv
**/*.gif

# Demo and test data (use testdata/ instead)
demo/
demo2/
demo/.obsidian

# memcli docker volume data (root-owned sqlite/WAL, created at runtime)
**/.trip2g-memory/

# Separate services (have their own Dockerfile)
ce-bot/
tge2e/

# Asset source/build files not needed in Go embed
# embed.go only needs: tiptap/tiptap.js, ui/*/- built artifacts
assets/milkdown/
assets/tiptap/node_modules/
assets/tiptap/src/

# Misc dev files
k6/
thoughts/

# CI/CD
.github/

# BMad workflow files
.bmad/
.claude/

# Git worktrees (agent-spawned checkouts, not needed for build)
.worktrees/

# OMC and related state dirs
.omc/
.omx/

# Demo / non-production data
businessdemo/

# Telegram session files
.tgsession.*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

testdata/vault
obsidian-sync

/assets/ui/-
/assets/ui/admin/-
/assets/ui/user/-
