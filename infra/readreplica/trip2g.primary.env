# /etc/trip2g.env on the PRIMARY (leader).
# The leader runs migrations + all writes against the LiteFS mount; LiteFS
# replicates them to the replica. It also accepts forwarded writes from
# replicas on its INTERNAL port (private NIC) — that is the X-Replica-Auth intake.

TRIP2G_DB_FILE=/litefs/data.sqlite3
TRIP2G_LISTEN_ADDR=:8081
# Internal port = health/metrics AND the leader-side replica write intake.
# Bind to the private NIC so the intake is never publicly reachable.
TRIP2G_INTERNAL_LISTEN_ADDR=10.20.0.2:8082

# Shared across leader + replica. Also signs the X-Replica-Auth HMAC.
TRIP2G_JWT_SECRET=rr-test-shared-jwt-secret
TRIP2G_DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
TRIP2G_OWNER_EMAIL=admin@example.com
TRIP2G_PUBLIC_URL=http://46.224.223.64:8081

# Object storage (MinIO runs on the primary's private NIC).
TRIP2G_MINIO_ENDPOINT=10.20.0.2:9000
TRIP2G_MINIO_ACCESS_KEY_ID=minioadmin
TRIP2G_MINIO_SECRET_KEY=minioadmin123
TRIP2G_MINIO_BUCKET=trip2g-backups
