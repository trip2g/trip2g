http:
  # Idempotent GETs that hit a backend mid-restart are retried. With a single
  # backend per site this only helps once a second backend exists (blue-green —
  # see docs/dev/zerodowntime.md); it is harmless otherwise and covers transient
  # upstream blips.
  middlewares:
    retry-idempotent:
      retry:
        attempts: 4

  routers:
{% for svc in trip2g_services %}
    {{ svc.service_name }}:
      rule: "Host(`{{ svc.domain }}`)"
      entryPoints:
        - websecure
      service: {{ svc.service_name }}
      middlewares:
        - retry-idempotent
      tls:
        certResolver: letsencrypt
{% if svc.extra_domains is defined %}
{% for extra in svc.extra_domains %}
    {{ svc.service_name }}_extra_{{ loop.index }}:
      rule: "Host(`{{ extra }}`)"
      entryPoints:
        - websecure
      service: {{ svc.service_name }}
      middlewares:
        - retry-idempotent
      tls:
        certResolver: letsencrypt
{% endfor %}
{% endif %}
{% endfor %}
    lottie-converter:
      rule: "Host(`{{ lottie_domain | default('ce.trip2g.com') }}`)"
      entryPoints:
        - websecure
      service: lottie-converter
      tls:
        certResolver: letsencrypt
    helpers:
      rule: "Host(`helpers.trip2g.com`)"
      entryPoints:
        - websecure
      service: helpers
      tls:
        certResolver: letsencrypt

  services:
{% for svc in trip2g_services %}
    {{ svc.service_name }}:
      loadBalancer:
        servers:
          - url: "http://{{ svc.listen_addr }}"
        # Active LIVENESS probe on the app's internal port. With socket activation
        # (the systemd .socket owns the public port), a restart keeps the socket
        # open and queues connections while the new process warms — so Traefik must
        # KEEP routing to the single backend during warmup, otherwise it would have
        # no backend and 503 clients. /livez stays 200 the whole time the process is
        # alive (incl. warmup) and only fails if the process is truly down, so the
        # check provides dead-backend failover without fighting the warmup queue.
        # (Use /readyz here only in a multi-backend blue-green setup.) port overrides
        # the server URL's port to reach the internal listener on the same host.
        healthCheck:
          path: /livez
          port: {{ svc.internal_addr.split(':')[1] }}
          interval: "1s"
          timeout: "1s"
{% endfor %}
    lottie-converter:
      loadBalancer:
        servers:
          - url: "http://localhost:{{ lottie_port | default('3000') }}"
    helpers:
      loadBalancer:
        servers:
          - url: "http://localhost:8099"
