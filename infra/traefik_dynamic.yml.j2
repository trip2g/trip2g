http:
  # Idempotent GETs that hit a backend mid-restart are retried. With a single
  # backend per site this only helps once a second backend exists (blue-green —
  # see docs/dev/zerodowntime.md); it is harmless otherwise and covers transient
  # upstream blips.
  middlewares:
    retry-idempotent:
      retry:
        attempts: 4

  routers:
{% for svc in trip2g_services %}
    {{ svc.service_name }}:
      rule: "Host(`{{ svc.domain }}`)"
      entryPoints:
        - websecure
      service: {{ svc.service_name }}
      middlewares:
        - retry-idempotent
      tls:
        certResolver: letsencrypt
{% if svc.extra_domains is defined %}
{% for extra in svc.extra_domains %}
    {{ svc.service_name }}_extra_{{ loop.index }}:
      rule: "Host(`{{ extra }}`)"
      entryPoints:
        - websecure
      service: {{ svc.service_name }}
      middlewares:
        - retry-idempotent
      tls:
        certResolver: letsencrypt
{% endfor %}
{% endif %}
{% endfor %}
    lottie-converter:
      rule: "Host(`{{ lottie_domain | default('ce.trip2g.com') }}`)"
      entryPoints:
        - websecure
      service: lottie-converter
      tls:
        certResolver: letsencrypt

  services:
{% for svc in trip2g_services %}
    {{ svc.service_name }}:
      loadBalancer:
        servers:
          - url: "http://{{ svc.listen_addr }}"
        # Active readiness probe on the app's internal port. /healthz returns 503
        # while draining (SIGTERM) or warming up, so Traefik stops routing to a
        # backend ~1-2s before its socket closes. port overrides the server URL's
        # port to reach the internal listener on the same host.
        healthCheck:
          path: /healthz
          port: {{ svc.internal_addr.split(':')[1] }}
          interval: "1s"
          timeout: "1s"
{% endfor %}
    lottie-converter:
      loadBalancer:
        servers:
          - url: "http://localhost:{{ lottie_port | default('3000') }}"
