{
  "scripts": {
    "start": "npx @tailwindcss/cli -i ./assets/styles.css -o ./assets/output.css",
    "trip2g-css": "npx tailwindcss -c ./demo/_layouts/trip2g.tailwind.config.js -o ./demo/_layouts/trip2g.css --watch",
    "dev": "vite",
    "graphqlgen": "graphql-codegen --config graphqlgen.js",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:e2e": "./scripts/test-e2e.sh",
    "test:e2e:ui": "./scripts/test-e2e.sh --ui",
    "test:e2e:headed": "./scripts/test-e2e.sh --headed",
    "whoami:mesh": "node scripts/e2e/whoami-mesh.mjs all",
    "whoami:down": "node scripts/e2e/whoami-mesh.mjs down",
    "test:e2e:whoami": "node scripts/e2e/whoami-mesh.mjs all && npx playwright test e2e/whoami-federation.spec.js --workers=1",
    "defaulttemplate-css": "node assets/defaulttemplate/esbuild.css.mjs",
    "defaulttemplate-css:watch": "node assets/defaulttemplate/esbuild.css.mjs --watch",
    "toc": "node assets/toc/esbuild.browser.mjs",
    "chart": "node assets/chart/esbuild.browser.mjs",
    "mermaid": "node assets/mermaid/esbuild.browser.mjs"
  },
  "dependencies": {
    "@types/change-case": "^0.0.30",
    "@types/jsdom": "^27.0.0",
    "change-case": "^5.4.4",
    "echarts": "^6.1.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-layout": "^0.6.1",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphql": "^16.10.0",
    "jsdom": "^28.0.0",
    "mermaid": "^11.15.0",
    "sigma": "^3.0.1",
    "sourcemap-codec": "^1.4.8"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.5",
    "@picocss/pico": "^2.1.1",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/cli": "^4.1.12",
    "@tailwindcss/typography": "^0.5.16",
    "daisyui": "^5.0.35",
    "esbuild-sass-plugin": "^3.7.0",
    "graphql-codegen-persisted-query-ids": "^0.2.0",
    "sass": "^1.97.3",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.22.2",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  }
}
